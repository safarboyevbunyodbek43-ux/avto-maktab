rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isTeacher() {
      return signedIn() && exists(userDoc(request.auth.uid)) && get(userDoc(request.auth.uid)).data.role == 'teacher';
    }
    function isSelf(studentId) { return signedIn() && studentId == request.auth.uid; }

    // Birinchi o'qituvchi yaratilganini bildiruvchi belgi (hamma o'qiy oladi, faqat bir marta yoziladi)
    match /meta/{id} {
      allow read: if true;
      allow create: if signedIn() && id == 'init'
        && !exists(/databases/$(database)/documents/meta/init)
        && getAfter(userDoc(request.auth.uid)).data.role == 'teacher';
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      // o'quvchini faqat o'qituvchi yaratadi; birinchi o'qituvchini esa meta/init yo'q paytdagina o'zi yaratadi
      allow create: if isTeacher()
        || (request.auth.uid == uid && request.resource.data.role == 'teacher'
            && !exists(/databases/$(database)/documents/meta/init));
      allow update, delete: if isTeacher();
    }

    match /credentials/{uid} { allow read, write: if isTeacher(); }
    match /groups/{id}      { allow read: if signedIn(); allow write: if isTeacher(); }
    match /payments/{id}    { allow read, write: if isTeacher(); }

    match /attendance/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.student_id == request.auth.uid);
      allow write: if isTeacher();
    }
    match /grades/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.student_id == request.auth.uid);
      allow write: if isTeacher();
    }
    match /attempts/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.student_id == request.auth.uid);
      allow create: if signedIn() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isTeacher();
    }
    match /stats/{uid} {
      allow read: if isTeacher() || isSelf(uid);
      allow write: if isTeacher() || isSelf(uid);
    }
  }
}
